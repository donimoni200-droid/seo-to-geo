generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* Admin user for the /admin panel — password stored as scrypt hash */
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/* Every editable content section of the public site, stored as JSON */
model Content {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/* Free guides (blog) — fully manageable from the admin panel */
model Guide {
  id        String   @id @default(cuid())
  slug      String   @unique
  tag       String   @default("General")
  title     String
  desc      String   @default("")
  readTime  String   @default("5 min")
  body      String   @default("[]") // JSON: [{ heading, paras: string[] }]
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* Waitlist / newsletter signups */
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("site")
  createdAt DateTime @default(now())
}

/* Contact form messages */
model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("")
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
